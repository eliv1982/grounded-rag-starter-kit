# Copy to `.env` at repo root. Do not commit `.env`.
# Values already set in the process environment take precedence over `.env`.
#
# This file includes two launch profiles:
# 1) Hosted OpenAI-compatible mode
# 2) Local Ollama / OpenAI-compatible mode
#
# Keep only one active profile in your `.env`.

# ============================================================
# Hosted OpenAI-compatible mode
# ============================================================
LLM_API_KEY=
# Optional OpenAI-compatible gateway URL (unset = the OpenAI default endpoint):
# LLM_BASE_URL=
# Historical names kept on purpose; they apply to any OpenAI-compatible endpoint, hosted or local:
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=5

# Hosted model examples:
RAG_CHAT_MODEL=gpt-4o-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# Local Ollama / OpenAI-compatible mode (example)
# ============================================================
# LLM_API_KEY=local-placeholder
# LLM_BASE_URL=http://localhost:11434/v1
# RAG_CHAT_MODEL=llama3.1:8b
# RAG_EMBEDDING_MODEL=nomic-embed-text
# RAG_CHROMA_PATH=runtime/chroma_db_local
# RAG_CORPUS_VERSION=local-dev-v1

# ============================================================
# Legacy compatibility / OpenAI-compatible fallback
# ============================================================
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
#
# If LLM_API_KEY / LLM_BASE_URL are set, they take precedence. Once LLM_API_KEY is set, a leftover
# OPENAI_BASE_URL is ignored on purpose (it cannot redirect where prompts are sent).
#
# ============================================================
# Common RAG settings (used by current code)
# ============================================================
# Corpus manifest (JSON, relative to repo root); required at every start (the vector index is validated against it).
# It may carry an optional "profile" (the vertical's chunking rules and system-prompt addition).
# Tiny synthetic sample shipped with the repo (no profile):
RAG_CORPUS_CONFIG=sample_corpus/corpus.json
# Other shipped verticals: examples/equipment_manual/corpus.json (synthetic, non-legal),
# examples/independent_guarantees/corpus.json (legal demo; its source texts are private and not in the repo).

# Retrieval quality
RAG_RAW_TOP_K=10
RAG_MAX_DISTANCE=0.44
RAG_FINAL_TOP_K=5
# Legacy fallback:
# RAG_TOP_K=5
RAG_MAX_TOKENS=1500
RAG_TEMPERATURE=0.3
RAG_CHROMA_PATH=runtime/chroma_db
# Name of the Chroma collection used by the CLI, web app, evaluation and scripts (default: rag_collection).
# RAG_COLLECTION_NAME=rag_collection
# Manual corpus label; changing it invalidates cached answers and rebuilds the vector index.
RAG_CORPUS_VERSION=hosted-dev-v1

# Embedding call behavior
OPENAI_EMBED_RETRIES=5
RAG_EMBED_BATCH_SIZE=16

# Indexing/chunking
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_MIN_CHUNK_LEN=80

# Optional network proxy
# HTTPS_PROXY=http://127.0.0.1:7890

# Optional CLI preview tuning
# RAG_CLI_CONTEXT_MAX_ITEMS=0
# RAG_CLI_CONTEXT_PREVIEW_CHARS=220

# ============================================================
# Optional evaluation (python evaluate_ragas.py --dataset <file>; needs requirements-eval.txt)
# ============================================================
# By default the judge model runs on the application's own endpoint (LLM_API_KEY / LLM_BASE_URL above),
# so a local configuration gets a local judge. A separate judge (for example hosted) is used ONLY when
# BOTH of these are set; the application's key is never sent to it:
# RAG_EVAL_JUDGE_BASE_URL=https://api.openai.com/v1
# RAG_EVAL_JUDGE_API_KEY=
# Judge model (default: RAG_CHAT_MODEL):
# RAG_EVAL_JUDGE_MODEL=
